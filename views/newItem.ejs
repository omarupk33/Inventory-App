<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>
</head>
<body>
    <h1>
       Last Mission Items✨
    </h1>
    <form action="/new/item" method="POST">
        <label for="name"> Item's name: </label>
        <input type="text" name="name" id="name">

        <label for="amount"> Number Of Items: </label>
        <input type="number" name="amount" id="amount">

        <label for="pic"> Picture(Url): </label>
        <input type="url" name="pic" id="pic">
     
        <button type="submit">Submit</button>
    </form>
</body>
</html>