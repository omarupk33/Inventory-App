<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>
</head>
<body>
    <h1>
        The Guild's Inventory✨
    </h1>

    <ul class="items-container">
    <%users.map((user)=>{%>    
        <li item-container>
            <div>
                <img src=<%=user.itempic%> alt=<%=user.itemname%>
                <h3>
                    Name: <%= user.itemname%>
                    Amount: <%=user.itemnum%> 
                    Category: <%=user.category%> 

                </h3>
            </div>
        </li>
        <%})%>
    </ul>


    <h1>
        Categories ✨
    </h1>

    <ul>
        <%categories.map((category)=>{%>
        <li>
            <%= category.categoryname    %>
        </li>
        
        <%})%>

    </ul>
</body>
</html>