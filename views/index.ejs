<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>
</head>
<body>
    <a href="/new/newItem">Add an Item</a>
    <a href="/new/newCategory">Add a Category</a>
    
    <h1>
        The Guild's Inventory✨
    </h1>

    <ul class="items-container">
            <%if(items){%>
    <%items.map((item)=>{%>    
        <li item-container>
            <div>
                <img src=<%=item.itempic%> alt=<%=item.itemname%>
                <h3>
                    Name: <%= item.itemname%>
                    Amount: <%=item.itemnum%> 
                    Category: <%=item.category%> 
                </h3>
                <% const path = `/update/items/${item.itemname}` %>

                <form action= <%= path %> method="GET">
                    <button>Update</button>
                </form>

                <% const deletePath = `/delete/items/${item.itemname}` %>
                <form action= <%= deletePath %> method="POST">
                    <button style="background-color: indianred;">Delete</button>
                </form>
            </div>
        </li>
        <%})}%>
    </ul>


    <h1>
        Categories ✨
    </h1>

    <ul>
        <%if(categories){%>
        <%categories.map((category)=>{%>
        <% const path = `/update/categories/${category.categoryname}` %>

        <li>
            <%= category.categoryname%>
        </li>

        <form action= <%= path %> method="GET">
            <button>Update</button>
        </form>
        <% const deletePath = `/delete/categories/${category.categoryname}` %>
                <form action= <%= deletePath %> method="POST">
                    <button style="background-color: indianred;">Delete</button>
                </form>
        <%})}%>
         
    </ul>
</body>
</html>