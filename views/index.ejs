<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>
</head>
<body>
    <h1>
        The Guild's Inventory✨
    </h1>

    <ul class="items-container">
    <%items.map((item)=>{%>    
        <li item-container>
            <div>
                <img src=<%=item.itempic%> alt=<%=item.itemname%>
                <h3>
                    Name: <%= item.itemname%>
                    Amount: <%=item.itemnum%> 
                    Category: <%=item.category%> 
                </h3>
                <% const path = `/update/${item.itemname}` %>

                <form action= <%= path %> method="GET">
                    <button>Update</button>
                </form>
            </div>
        </li>
        <%})%>
    </ul>


    <h1>
        Categories ✨
    </h1>

    <ul>
        <%categories.map((category)=>{%>
        <li>
            <%= category.categoryname%>
        </li>
        
        <%})%>

    </ul>
</body>
</html>